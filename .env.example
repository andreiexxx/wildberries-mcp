# Скопируйте в .env и заполните. Файл .env никому не пересылайте.
# Установщик install.sh заполнит его сам.

# Домен, по которому сервер будет доступен (без https://)
DOMAIN=wb.example.ru

# Токен WB: кабинет → Интеграции по API → персональный токен
WB_TOKEN=

# Секрет для адреса коннектора. Сгенерировать: openssl rand -hex 24
MCP_SECRET=

# Разрешить Claude менять ставки, паузы и цены. По умолчанию — нет.
# Включайте, только если понимаете риск: любой, у кого есть адрес
# коннектора, сможет менять кабинет.
WB_ALLOW_WRITE=false
